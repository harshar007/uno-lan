{
  "expo": {
    "name": "STACK UNO",
    "slug": "stack-uno",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "stackuno",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "STACK UNO requires access to your local Wi-Fi network to connect to multiplayer games."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080808"
      },
      "permissions": [
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
